// ==========================================
// TEST SUITE GEM-17 : BREAK & CONTINUE
// ==========================================

print "--- Test 1 : Loop avec Continue ---"
for (mut i : int = 0; i < 5; i++) {
    if (i == 2) {
        continue
    }
    print i
}
// Attendu :
// 0
// 1
// 3
// 4

print "--- Test 2 : Loop avec Break ---"
mut j : int = 0
while (j < 10) {
    if (j == 3) {
        break
    }
    print j
    j++
}
// Attendu :
// 0
// 1
// 2