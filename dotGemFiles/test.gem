// =========================================================================
// 1. Déclarations de fonctions (GEM-14)
// =========================================================================

// Fonction avec retour de calcul
fn add(a : int, b : int) : int {
    return a + b
}

// Fonction manipulant des comparaisons et des conditions
fn max(a : int, b : int) : int {
    if a >= b {
        return a
    }
    return b
}

// Procédure sans return explicite (ExpressionStmt)
fn greet(name : string) {
    print "Bonjour " + name
}

// =========================================================================
// 2. Programme principal
// =========================================================================

print "=== Test 1 : Appel de procédure ==="
greet("GEM Developer")

print "=== Test 2 : Fonctions & Arithmétique ==="
mut x : int = 15
mut y : int = 25
mut sum : int = add(x, y)
print sum

print "=== Test 3 : Comparaisons (>=, <=) & Max ==="
mut highest : int = max(x, y)
print highest

print "=== Test 4 : Structure FOR & Opérateurs logiques ==="
for (mut i : int = 0; i <= 3; i = i + 1) {
    if i >= 1 && i <= 2 {
        print i
    }
}

print "=== Test 5 : Portée (Scope) & Shadowing ==="
mut value : int = 100
{
    mut value : int = 500
    print value
}
print value